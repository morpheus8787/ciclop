# --- Burza a trh ---
EXCHANGE=coinbase
SYMBOL=BTC/EUR             # jen BTC (jiné aktivum vyžaduje ALLOW_ALTCOINS=true); v EU také BTC/USDC
TIMEFRAME=1d               # trend-following na denních svíčkách
# exchange = data z burzy (ccxt), binance_vision = veřejná data Binance (když je burza z dané sítě blokovaná)
MARKET_DATA=exchange

# paper = simulace se živými daty, live = skutečné peníze (Coinbase nemá testnet)
MODE=paper
# Coinbase CDP API klíč (coinbase.com/developer-platform → API keys, oprávnění View + Trade, BEZ Transfer):
# API_KEY=organizations/<org_id>/apiKeys/<key_id>
# API_SECRET=-----BEGIN EC PRIVATE KEY-----\nMHcC...\n-----END EC PRIVATE KEY-----\n   (jeden řádek, konce řádků jako \n)
API_KEY=
API_SECRET=
# Pro MODE=live musí být přesně: I_UNDERSTAND_THE_RISK
LIVE_CONFIRM=

# --- Strategie ---
STRATEGY=trend             # trend = průraz kanálu (Donchian) nad EMA200; patterns = původní svíčkové patterny
ENTRY_PERIOD=20            # nákup, když close překoná maximum posledních 20 dní
EXIT_PERIOD=10             # prodej, když close spadne pod minimum posledních 10 dní
STOP_ATR_MULT=3.0          # počáteční stop = vstup − 3 × ATR
TRAIL_ATR_MULT=3.0         # trailing stop = nejvyšší cena − 3 × ATR (posouvá se jen nahoru)
TAKE_PROFIT_R=0            # 0 = bez pevného cíle, zisky nechat běžet

# --- Řízení rizika ---
RISK_PER_TRADE=0.01        # max. ztráta na obchod = 1 % účtu
MAX_POSITION_PCT=0.25      # max. 25 % účtu v jedné pozici
MAX_ORDER_QUOTE=50         # tvrdý strop objednávky v quote měně (EUR) – pojistka pro live
MAX_DAILY_LOSS_PCT=0.03    # po ztrátě 3 % za den se agent zastaví
MAX_TRADES_PER_DAY=4
FEE_RATE=0.009             # Coinbase Advanced taker na nejnižší úrovni (0,6–1,2 %); ověř si svůj tarif v aplikaci
PAPER_START_EQUITY=1000

# --- Zprávy ---
NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss,https://cointelegraph.com/rss,https://www.ft.com/crypto?format=rss,https://www.ft.com/markets?format=rss
NEWS_LOOKBACK_HOURS=6
NEWS_EXIT_ON_PANIC=true
NEWS_FAIL_SAFE=block       # když zprávy nejdou stáhnout: block = nenakupovat, ignore = pokračovat

POLL_SECONDS=30
STATE_DIR=state

# --- Učení z vlastních obchodů ---
AUTO_ADAPT=true            # po ADAPT_EVERY_TRADES uzavřených obchodech udělá rozbor a ověřené závěry použije
ADAPT_EVERY_TRADES=10
ADAPT_MIN_TRADES=15        # min. vzorek, než se z dané skupiny obchodů dělají závěry
ADAPT_HISTORY_DAYS=3000    # na denních svíčkách je potřeba dlouhá historie
